  portraitLeft: {fileID: 0}
  portraitRight: {fileID: 0}
  nameLeft: "\u300C\u987E\u5BA2\u300D"
  nameRight: "\u300C\u524D\u8F88\u300D"
  lines:
  - speaker: 0
    text: "\u4F60\u597D\uFF0C\u6211\u8981\u300C\u53CC\u62FC\u523A\u8EAB\u5B9A\u98DF\u300D\uFF0C\u5C11\u82A5\u672B\u3002"
    lineBeginEventId: 
    lineCompleteEventId: 
  - speaker: 1
    text: "\u597D\u7684\uFF0C\u8BF7\u7A0D\u7B49\uFF0C\u4F1A\u5C3D\u5FEB\u4E3A\u60A8\u4E0A\u83DC\u3002"
    lineBeginEventId: 
    lineCompleteEventId: 
  - speaker: 0
    text: "\u5BF9\u4E86\uFF0C\u4E4B\u524D\u8D1F\u8D23\u8FD9\u4E2A\u684C\u5B50\u7684\u5E97\u5458\u600E\u4E48\u4E0D\u89C1\u4E86\uFF1F"
    lineBeginEventId: 
    lineCompleteEventId: 
  - speaker: 1
    text: "\u95E8\u5E97\u6269\u5F20\uFF0C\u524D\u8F88\u524D\u5F80\u5176\u4ED6\u95E8\u5E97\u4EFB\u804C\u4E86\u3002"
    lineBeginEventId: 
    lineCompleteEventId: 
  - speaker: 0
    text: "\u539F\u6765\u5982\u6B64\uFF0C\u90A3\u4F60\u4EEC\u8C03\u52A8\u9891\u7387\u86EE\u9AD8\u7684\u554A\u3002"
    lineBeginEventId: 
    lineCompleteEventId: 
  dialogueStartEventId: 
  dialogueEndEventId: 
  typingSoundOverride: {fileID: 0}
