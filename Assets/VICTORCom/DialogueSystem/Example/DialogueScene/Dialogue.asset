  lines:
  - speaker: 0
    text: "\u95E8\u8FD8\u5269\u4E09\u5341\u79D2\u5173\u95ED\u3002\u6211\u8981\u8FDB\u53BB\u3002"
    lineBeginEventId: 
    lineCompleteEventId: 
  - speaker: 1
    text: "\u91CC\u9762\u6CA1\u6709\u4FE1\u53F7\uFF0C\u6CA1\u6709\u652F\u63F4\uFF0C\u4F60\u8FDB\u53BB\u5C31\u662F\u9001\u6B7B\u3002"
    lineBeginEventId: 
    lineCompleteEventId: 
  - speaker: 0
    text: "\u6211\u8FFD\u8E2A\u8FD9\u4E2A\u76EE\u6807\u8FFD\u4E86\u4E09\u4E2A\u5730\u56FE\u3002\u8FD9\u6B21\u4E0D\u4F1A\u518D\u8BA9\u5B83\u8DD1\u4E86\u3002"
    lineBeginEventId: 
    lineCompleteEventId: 
  - speaker: 1
    text: .........
    lineBeginEventId: 
    lineCompleteEventId: 
  - speaker: 1
    text: "\u4F60\u7684\u547D\u6BD4\u4E00\u4E2ABoss\u91CD\u8981\u3002"
    lineBeginEventId: 
    lineCompleteEventId: 
  - speaker: 0
    text: "\u90A3\u4F60\u600E\u4E48\u4E0D\u8DDF\u6211\u6765\uFF1F"
    lineBeginEventId: 
    lineCompleteEventId: 
  - speaker: 1
    text: "\u56E0\u4E3A\u603B\u5F97\u6709\u4EBA\u6D3B\u7740\u56DE\u53BB\u4EA4\u4EFB\u52A1\u3002"
    lineBeginEventId: 
    lineCompleteEventId: 
  - speaker: 0
    text: "\u2026\u4F60\u8BA4\u771F\u7684\uFF1F"
    lineBeginEventId: 
    lineCompleteEventId: 
