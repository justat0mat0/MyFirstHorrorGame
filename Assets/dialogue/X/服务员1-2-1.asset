  m_Script: {fileID: 11500000, guid: 27f8749596482864282d738d4e870adc, type: 3}
  m_Name: "\u670D\u52A1\u54581-2-1"
  m_EditorClassIdentifier: 
  portraitLeft: {fileID: 21300000, guid: aa8ded99756db7e43ac90f97108de562, type: 3}
  portraitRight: {fileID: 21300000, guid: 85df844907a80d24f8c35d60f3b7abf1, type: 3}
  nameLeft: Minsu
  nameRight: "\u670D\u52A1\u54581"
  lines:
  - speaker: 1
    text: "\u4ECA\u5929\u662F\u7ED9\u6148\u5584\u7EC4\u7EC7\u63D0\u4F9B\u9910\u76D2\u7684\u65E5\u5B50\uFF0C\u9700\u8981\u7531\u6211\u4EEC\u6765\u5B8C\u6210"
    lineBeginEventId: 
    lineCompleteEventId: 
  - speaker: 1
    text: "\u4ECA\u5929\u7684\u83DC\u5355\u662F\u9910\u76D2\u83DC\u5355"
    lineBeginEventId: 
    lineCompleteEventId: 
  - speaker: 1
    text: "\u98DF\u6750\u53EF\u4EE5\u5728\u4ED3\u5E93\u91CC\u53D6\uFF0C\u53D6\u98DF\u6750\u7684\u65F6\u5019\u8BB0\u5F97\u6234\u4E0A\u5DE5\u724C\u5F00\u95E8"
    lineBeginEventId: 
    lineCompleteEventId: 
  - speaker: 1
    text: "\u5269\u4E0B\u7684\u4FE1\u606F\u53EF\u4EE5\u770B\u5458\u5DE5\u624B\u518C"
    lineBeginEventId: 
    lineCompleteEventId: 
  - speaker: 1
    text: "\u9910\u76D2\u5B8C\u6210\u4E4B\u540E\u9700\u8981\u62FF\u5230\u540E\u95E8\u5916\uFF0C\u6148\u5584\u7EC4\u7EC7\u4F1A\u6D3E\u4EBA\u6765\u53D6"
    lineBeginEventId: 
    lineCompleteEventId: 
  dialogueStartEventId: 
  dialogueEndEventId: 
  typingSoundOverride: {fileID: 0}
